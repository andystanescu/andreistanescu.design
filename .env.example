# Required for admin sessions and protected case studies. Generate a random secret.
SESSION_SECRET=

# Set the public HTTPS origin for metadata, sitemap and recovery links.
PUBLIC_SITE_URL=http://localhost:3000

# Optional when creating credentials through /admin/login on first use.
ADMIN_USERNAME=
# Bcrypt hash. Escape each dollar sign with a backslash in Next.js .env files.
ADMIN_PASSWORD_HASH=

# Optional email integration. Contact submissions are saved without email.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
ADMIN_RECOVERY_EMAIL=

# Optional paths; default to ./data and ./public/uploads.
# For production, point these at durable writable storage provided by your host.
DATA_DIR=
UPLOADS_DIR=
